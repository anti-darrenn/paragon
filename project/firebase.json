{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "paragon-hq",
          "appId": "1:466922201959:android:066784517759a489c305c2",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "paragon-hq",
          "configurations": {
            "android": "1:466922201959:android:066784517759a489c305c2",
            "macos": "1:466922201959:ios:6805785538357736c305c2",
            "web": "1:466922201959:web:16451317926646aec305c2",
            "windows": "1:466922201959:web:b2de0bfaef5ea1a1c305c2"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "regex": "^/(?:(?:about|account|admin|c|cards|courses|dashboard|join|learn|legal|me|mistakes|onboarding|plan|privacy|review|rooms|saved|search|settings|signin|subject|subjects|support|terms|try|waec|welcome)(?:/.*)?)?$",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "regex": "^/(?:[^_].*|_[^_].*|_)?$",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://www.gstatic.com https://www.googletagmanager.com https://apis.google.com https://www.youtube.com https://www.google.com/recaptcha/; style-src 'self' 'unsafe-inline'; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.googleapis.com https://www.gstatic.com https://fonts.gstatic.com https://*.google-analytics.com https://www.googletagmanager.com https://paragon-hq.firebaseapp.com; frame-src https://paragon-hq.firebaseapp.com https://www.youtube-nocookie.com https://accounts.google.com https://apis.google.com https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/; worker-src 'self' blob:; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "regex": "^/(?:(?:about|account|admin|c|cards|courses|dashboard|join|learn|legal|me|mistakes|onboarding|plan|privacy|review|rooms|saved|search|settings|signin|subject|subjects|support|terms|try|waec|welcome)(?:/.*)?)?$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/past-questions/img/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'none'; img-src data:; style-src 'unsafe-inline'; sandbox"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/@(main.dart.js|flutter_bootstrap.js|flutter.js|flutter_service_worker.js|version.json|manifest.json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
