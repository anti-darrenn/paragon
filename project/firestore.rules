rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /subjects/{id}  { allow read: if true; }
    match /units/{id}     { allow read: if request.auth != null; }
    // `lessonCount` is the one topic field a client may write, and only a
    // reviewer: the studio keeps it in step when it publishes, unpublishes
    // or deletes a lesson. Everything else on a topic stays
    // Admin-SDK-only. `jobs.js --job=counts` recomputes it nightly anyway,
    // so a missed update heals by morning.
    match /topics/{id} {
      allow read: if request.auth != null;
      allow update: if reviews(resource.data.subjectId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lessonCount'])
        && request.resource.data.lessonCount is int
        && request.resource.data.lessonCount >= 0;
    }
    // Questions are Admin-SDK-only except for one path: a reviewer
    // resolving a student's problem report in the studio. That can change
    // the marked answer or retire the question, nothing else — stem,
    // options and topic stay seeder-only. `previousCorrectIndex` is written
    // alongside every answer change so a bad fix can be reverted.
    match /questions/{id} {
      allow read: if request.auth != null;
      allow update: if reviews(resource.data.subjectId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['correctIndex', 'previousCorrectIndex', 'hasAnswer',
                       'reviewedAt', 'reviewedBy'])
        && request.resource.data.hasAnswer is bool
        && (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['correctIndex'])
            || (request.resource.data.correctIndex is int
                && request.resource.data.correctIndex >= 0
                && request.resource.data.correctIndex
                     < resource.data.options.size()));
    }

    // ── LEARN RESOURCES ─────────────────────────────────────────
    // A topic's ordered lesson content: videos, articles, exercises.
    //
    // Its own block because rules do NOT cascade into subcollections —
    // the `topics/{id}` rule above says nothing about what lives beneath
    // it, and without this every read here would be denied.
    //
    // Published resources are readable by any signed-in user (a guest
    // included — Learn content is deliberately ungated; only drill is
    // gated). Everything else — draft, in_review, changes_requested — is
    // readable only by the content team.
    //
    // Rules are not filters: a list query is refused outright unless it
    // provably returns only readable documents. So a student's query MUST
    // carry `where('status', '==', 'published')` — see
    // `topicResourcesProvider` — and an unfiltered list is denied.
    //
    // Do NOT add a "missing status counts as published" clause here. It was
    // tried: when evaluating a list, Firestore models `resource.data` from
    // the query's filters, so for an unfiltered query `!('status' in
    // resource.data)` is true and the whole list — drafts included — is
    // allowed. Measured against production, not assumed. Every resource
    // now carries `status` (`jobs.js --job=resourcestatus` backfilled the
    // old ones; the seeder and editor always write it), so none is needed.
    //
    // Writes follow the review workflow (docs/CONTENT_ROLES.md):
    //  - a reviewer may write anything;
    //  - a writer may create and edit only while the item is — and stays —
    //    unpublished: draft, in_review, or changes_requested. A writer can
    //    never publish, never edit a published item (they start a revision
    //    instead), and can only keep `changes_requested` on an item that
    //    already has it, never set it: that is the reviewer's verdict.
    //  - a writer may delete only their own draft.
    //  - both only within their subjects, when their role is limited to
    //    some (`writes()` / `reviews()`); an item can't be moved out of
    //    scope either, since both the old and new subjectId are checked.
    // The seeder still uses the Admin SDK, which bypasses rules.
    match /topics/{topicId}/resources/{resourceId} {
      allow read: if request.auth != null
        && (resource.data.status == 'published' || isWriter());
      allow create: if reviews(request.resource.data.subjectId)
        || (writes(request.resource.data.subjectId)
            && request.resource.data.status in ['draft', 'in_review']);
      allow update: if (reviews(resource.data.subjectId)
            && reviews(request.resource.data.subjectId))
        || (writes(resource.data.subjectId)
            && writes(request.resource.data.subjectId)
            && resource.data.status in writerStatuses()
            && request.resource.data.status in writerStatuses()
            && (request.resource.data.status != 'changes_requested'
                || resource.data.status == 'changes_requested'));
      allow delete: if reviews(resource.data.subjectId)
        || (writes(resource.data.subjectId)
            && resource.data.status == 'draft'
            && resource.data.get('createdBy', '') == request.auth.uid);

      // Every save keeps the previous content, so any edit can be undone.
      // Append-only: a version is never rewritten or removed from a client.
      match /versions/{versionId} {
        allow read: if isWriter();
        allow create: if writes(parentSubject(topicId, resourceId));
      }

      // Review threads. Anyone on the team may read; comment within your
      // subjects; an author edits their own; a reviewer may resolve or
      // remove any in their subjects.
      match /comments/{commentId} {
        allow read: if isWriter();
        allow create: if writes(parentSubject(topicId, resourceId))
          && request.resource.data.authorUid == request.auth.uid;
        allow update: if writes(parentSubject(topicId, resourceId))
          && (resource.data.authorUid == request.auth.uid
              || reviews(parentSubject(topicId, resourceId)))
          && request.resource.data.authorUid == resource.data.authorUid;
        allow delete: if reviews(parentSubject(topicId, resourceId))
          || (isWriter() && resource.data.authorUid == request.auth.uid);
      }
    }

    // Collection-group reads across every topic's resources: the studio's
    // course map and review queue. A collection-group query is matched
    // only by a recursive wildcard like this one, never by the path-scoped
    // block above, so without it the query is refused even for staff.
    match /{path=**}/resources/{resourceId} {
      allow read: if isWriter();
    }

    // ── LESSON IMAGES ───────────────────────────────────────────
    // Uploaded by the studio, compressed well under Firestore's 1 MB
    // document limit (no Storage bucket on Spark). Readable by any
    // signed-in user so published lessons can show them.
    match /lessonAssets/{assetId} {
      allow read: if request.auth != null;
      allow create: if isWriter()
        && request.resource.data.keys().hasOnly(
             ['mime', 'data', 'width', 'height', 'createdBy', 'createdAt'])
        && request.resource.data.mime in
             ['image/webp', 'image/jpeg', 'image/png', 'image/svg+xml']
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 900000
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if false;
      allow delete: if isReviewer();
    }

    // ── SUBJECT INDEX ───────────────────────────────────────────
    // One document per subject holding its glossary, formulas and revision
    // cards, extracted from published lessons when a reviewer publishes.
    // One read gives a student all three features.
    match /subjectIndex/{subjectId} {
      allow read: if request.auth != null;
      allow write: if reviews(subjectId);
    }

    // ── ACCOUNT REQUESTS ────────────────────────────────────────
    // "Sign out everywhere" needs the Admin SDK (revokeRefreshTokens),
    // so the app files a request here and
    // `tools/admin/apply_account_requests.js` carries it out every 15
    // minutes, then deletes it. One per student, id'd by uid; exact shape,
    // real server time, and only the one request type so far.
    match /accountRequests/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(['type', 'requestedAt'])
        && request.resource.data.type == 'revokeSessions'
        && request.resource.data.requestedAt == request.time;
    }

    // ── STAFF PROFILES ──────────────────────────────────────────
    // A team member's name and avatar, published by themselves so the
    // rest of the team can see who wrote a comment or an item — users/
    // {uid} stays owner-only for staff as for everyone. Readable by the
    // team and by its owner (so a student's export and deletion can look
    // for one without being refused); written only by a team member, for
    // themselves, in exactly this shape.
    match /staffProfiles/{uid} {
      allow read: if isWriter() || isOwner(uid);
      allow delete: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) && isWriter()
        && request.resource.data.keys()
             .hasOnly(['displayName', 'avatar', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 60
        && (!('avatar' in request.resource.data)
          || (request.resource.data.avatar is string
            && request.resource.data.avatar
                 .matches('^(preset|initials):[a-z_]{2,20}$')))
        && request.resource.data.updatedAt == request.time;
    }

    // ── TEAM REQUESTS ───────────────────────────────────────────
    // Admins manage the content team from the studio's Team page. Claims
    // can only be set with the Admin SDK, so the page writes a request
    // here and `tools/admin/apply_roles.js` (every 15 minutes, in the
    // notify-drafts workflow) applies it and records the outcome. Admin
    // only in both directions; `role` can never be `admin`.
    match /staffInvites/{emailKey} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.role in ['writer', 'reviewer', 'none']
        && request.resource.data.subjects is list
        && request.resource.data.subjects.size() <= 20;
    }

    // ── USER DOCUMENTS ──────────────────────────────────────────
    // Owner-only, but no longer a blanket `write`: creation is limited to
    // an exact field set, and username/usernameKey can only be set by
    // claiming a matching reservation and are then immutable. Every other
    // field client code writes today (displayName, selectedSubjects,
    // profile, avatar, bio) is allow-listed explicitly in
    // `clientWritableFields` below; anything not named there — including
    // fields that don't exist yet, like a future XP or topicStats — is
    // server-only by construction.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow delete: if isOwner(uid);

      // Provisioning writes exactly these five fields — see
      // UserRepository.createUserIfNew. Restricted to that exact set
      // (not just "no username yet") so a client cannot `create` the
      // document directly with an extra field — e.g. a pre-set `level`
      // or `topicStats` — that then sits untouched forever, since
      // `onlyClientWritableFields` below only inspects what *changes* on
      // an update, never what already exists from creation.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
             'uid', 'email', 'displayName', 'isAnonymous', 'createdAt'
           ])
        && request.resource.data.uid == uid
        // Forces the real serverTimestamp() sentinel rather than a
        // client-supplied value — the standard Firestore Rules idiom for
        // verifying serverTimestamp() was actually used.
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner(uid)
        && usernameWriteIsValid(uid)
        && onlyClientWritableFields()
        && clientFieldsAreValid();
    }

    // Shape checks for the fields a student edits directly. Checked on the
    // document after the write, so a merge that leaves them alone passes,
    // and an absent field (never set, or deleted) passes too.
    // `avatar` is `preset:<id>` or `initials:<colour>` — see
    // lib/core/models/avatar.dart. `bio` is capped at kBioMaxLength.
    function clientFieldsAreValid() {
      let after = request.resource.data;
      // A scheduled deletion is stamped with the real server time (the
      // 30 days are counted from it) or removed to cancel it. A
      // client-chosen date could bring the deletion forward or push it
      // back indefinitely.
      let deletionStamp = !request.resource.data.diff(resource.data)
          .affectedKeys().hasAny(['deletionRequestedAt'])
        || !('deletionRequestedAt' in after)
        || after.deletionRequestedAt == request.time;
      // Accepting the terms records the version with the server's clock,
      // together; neither can be written alone or backdated.
      let legalStamp = !request.resource.data.diff(resource.data)
          .affectedKeys().hasAny(['legalVersion', 'legalAcceptedAt'])
        || (after.legalVersion is string
          && after.legalVersion.size() <= 32
          && after.legalAcceptedAt == request.time);
      return deletionStamp && legalStamp
        && (!('avatar' in after)
          || (after.avatar is string
              && after.avatar.matches('^(preset|initials):[a-z_]{2,20}$')))
        && (!('bio' in after)
          || (after.bio is string && after.bio.size() <= 160));
    }

    // Allow-list, not a deny-list. Anything not named here cannot be
    // written from a client at all — including fields that do not exist
    // yet. When XP, levels and topicStats arrive they are therefore
    // server-only by default, and shipping a leaderboard does not depend
    // on somebody remembering to lock them first.
    function clientWritableFields() {
      return [
        'displayName', 'selectedSubjects', 'profile', 'updatedAt',
        'avatar', 'bio', 'usernameChangedAt', 'deletionRequestedAt',
        'legalVersion', 'legalAcceptedAt',
        'username', 'usernameKey',
        'email', 'isAnonymous'
      ];
    }

    function onlyClientWritableFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(clientWritableFields());
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // A custom claim on the ID token, set only by
    // `tools/admin/set_admin_claim.js` with the Admin SDK. Never a field on
    // `users/{uid}` — anything a client can write there, a client can
    // grant itself.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Content-team roles — custom claims, set only by
    // `tools/admin/set_role.js`. A reviewer can do everything a writer can;
    // an admin, everything a reviewer can. See docs/CONTENT_ROLES.md.
    function isReviewer() {
      return isAdmin()
        || (request.auth != null && request.auth.token.reviewer == true);
    }

    function isWriter() {
      return isReviewer()
        || (request.auth != null && request.auth.token.writer == true);
    }

    // A role may be limited to some subjects: the `subjects` claim lists
    // their ids. No such claim means every subject. Admins are never
    // limited. See docs/CONTENT_ROLES.md.
    function inScope(subjectId) {
      return isAdmin()
        || !('subjects' in request.auth.token)
        || subjectId in request.auth.token.subjects;
    }

    function writes(subjectId) {
      return isWriter() && inScope(subjectId);
    }

    function reviews(subjectId) {
      return isReviewer() && inScope(subjectId);
    }

    // The subjectId of a lesson item, for rules on its subcollections.
    // One document read, charged only when such a write is attempted.
    function parentSubject(topicId, resourceId) {
      return get(/databases/$(database)/documents/topics/$(topicId)/resources/$(resourceId)).data.subjectId;
    }

    // The statuses a writer may leave an item in. Everything but published.
    function writerStatuses() {
      return ['draft', 'in_review', 'changes_requested'];
    }

    // Governs the username/usernameKey pair on an update. Three cases:
    //
    //   - the document already has a username -> it is immutable
    //   - the update does not mention one     -> nothing to check
    //   - the update claims one               -> it must match a
    //     reservation this user actually holds
    //
    // The last case is why usernames are lower-cased and nothing else:
    // rules can compute `.lower()` but cannot strip characters, so any
    // richer normalisation would be unverifiable here and uniqueness
    // would collapse back to a client-side promise.
    // A username is set once by claiming a reservation, and after that
    // may only move to another reservation the student owns, at most once
    // every 90 days (UsernameRules.changeCooldown). `usernameChangedAt`
    // is written only as part of such a change and only as the real
    // server time — otherwise a client could backdate it and skip the
    // wait. Old reservations are never released (see /usernames below).
    function usernameWriteIsValid(uid) {
      let after = request.resource.data;
      let hadUsername = 'username' in resource.data
        && resource.data.username is string
        && resource.data.username.size() > 0;
      let unchanged = after.username == resource.data.username
        && after.usernameKey == resource.data.usernameKey;
      let stampUntouched = !request.resource.data.diff(resource.data)
        .affectedKeys().hasAny(['usernameChangedAt']);

      return hadUsername
        ? (unchanged && stampUntouched) || usernameChangeIsValid(uid, after)
        : stampUntouched
          && ((!('username' in after) && !('usernameKey' in after))
            || claimsOwnReservation(uid, after));
    }

    function usernameChangeIsValid(uid, after) {
      return claimsOwnReservation(uid, after)
        && after.usernameChangedAt == request.time
        && (!('usernameChangedAt' in resource.data)
          || request.time > resource.data.usernameChangedAt
               + duration.value(90, 'd'));
    }

    function claimsOwnReservation(uid, after) {
      return after.username is string
        && after.usernameKey is string
        && after.username.lower() == after.usernameKey
        && exists(/databases/$(database)/documents/usernames/$(after.usernameKey))
        && get(/databases/$(database)/documents/usernames/$(after.usernameKey)).data.uid == uid;
    }

    match /attempts/{id} {
      allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null
          && resource.data.userId == request.auth.uid;
      // Delete-own exists so account deletion can actually remove a
      // student's practice history. Still no update: an attempt is a
      // record of what happened and must not be edited after the fact.
      allow delete: if request.auth != null
          && resource.data.userId == request.auth.uid;
    }

    // ── PRACTICE PROGRESS (mastery rings) ────────────────────────
    // A private, display-only cache of per-topic counters, one document
    // per student, id'd by uid. It exists because counting `attempts` per
    // topic would need one aggregate query per topic — see
    // `progress_repository.dart` for the full reasoning.
    //
    // Deliberately NOT on `users/{uid}`: that document's allow-list keeps
    // stats fields server-only so a future leaderboard cannot be fed by
    // the client, and nothing here is allowed to undermine that. The
    // constraint that keeps the two compatible is a product rule, not a
    // rules-file one — nothing competitive may read this collection — so
    // it is written down in the repository and in CLAUDE.md. What the
    // rules can enforce, they do: owner-only in both directions, so these
    // numbers are never visible to another student, and a closed field
    // set, so this cannot become a dumping ground for whatever a client
    // feels like storing.
    match /progress/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['userId', 'updatedAt', 'topics'])
          && request.resource.data.userId == uid
          // Forces the real serverTimestamp() sentinel, the same way the
          // `users` create rule pins `createdAt`. Without it a client
          // could backdate its own cache, which matters the day anything
          // server-side starts reconciling this against `attempts`.
          && request.resource.data.updatedAt == request.time
          && request.resource.data.topics is map;
    }

    // ── TOPIC TEST RESULTS (the drill gate) ──────────────────────
    // One document per student, id'd by uid. Records which topic tests
    // have been passed, which is what unlocks drill for that topic.
    //
    // Deliberately NOT merged into `progress/{uid}`. That document is
    // described everywhere — here, in its repository, in CLAUDE.md — as a
    // cache recomputable from `attempts`, and every safety claim made for
    // it rests on that being true. A test pass is NOT recomputable:
    // nothing in `attempts` records which ten answers belonged to one
    // sitting. Putting it there would make that description a lie.
    //
    // **What these rules cannot do.** They cannot verify that `passed`
    // was earned. A write is one document; the ten answers behind it are
    // not in it, and rules cannot iterate a map with dynamic keys to
    // check each entry. So the gate is client-enforced and a determined
    // student can open it by hand. That is a deliberate, bounded
    // acceptance: drill is practice rather than a reward, nothing
    // competitive reads this, and the prize for forging it is a practice
    // screen. If anything of value is ever put behind this gate, it needs
    // a server first.
    //
    // What the rules DO enforce is the same envelope as `progress`:
    // owner-only in both directions, a closed top-level field set so this
    // cannot become a dumping ground, and a real serverTimestamp().
    match /learn/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['userId', 'updatedAt', 'topics'])
          && request.resource.data.userId == uid
          && request.resource.data.updatedAt == request.time
          && request.resource.data.topics is map;
    }

    // ── QUESTION FLAGS (student-reported problems) ───────────────
    // The answer key is scraped from a third party with a measured error
    // rate, so students reporting a wrong answer is how we find the bad
    // ones. Students file them; reviewers resolve them in the studio.
    //
    // `status` is open | fixed | dismissed, and a missing status means
    // open — reports filed before review existed, or by a cached build,
    // carry none. A student may file one only as open (or without a
    // status), so nobody can file a report that is already closed.
    match /flags/{id} {
      allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && (!('status' in request.resource.data)
              || request.resource.data.status == 'open');
      // Read-own and delete-own, narrowly: a deleting user has to be able
      // to find and remove reports that carry their uid, and the client
      // cannot delete what it cannot query. Reviewers read every report.
      allow read: if request.auth != null
          && (resource.data.userId == request.auth.uid || isReviewer());
      allow delete: if request.auth != null
          && resource.data.userId == request.auth.uid;
      // Resolution only: a reviewer closes or reopens a report. What the
      // student reported (question, reason, who, when) is never rewritten.
      allow update: if isReviewer()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'resolvedAt', 'resolvedBy'])
          && request.resource.data.status in ['open', 'fixed', 'dismissed'];
    }

    // ── NOTES, HIGHLIGHTS, BOOKMARKS, REVISION CARDS ─────────────
    // A student's own study data. Owner-only in both directions, with a
    // closed field set. Guests keep theirs on the device only, so
    // anonymous accounts may not write here; reads and deletes stay
    // owner-only for everyone, which account deletion relies on.
    // `AccountRepository.deleteOwnedDocuments` removes both.

    // One document per annotated block: its highlight and/or note. A note
    // keeps a snapshot of the block's text, so rewording a lesson shows
    // the note as "from an earlier version" instead of losing it.
    match /notes/{noteId} {
      function noteShapeOk(d) {
        return d.keys().hasOnly(['userId', 'topicId', 'resourceId',
                                 'subjectId', 'blockKey', 'colour', 'text',
                                 'snapshot', 'createdAt', 'updatedAt'])
          && d.keys().hasAll(['userId', 'topicId', 'resourceId', 'subjectId',
                              'blockKey', 'colour', 'text', 'snapshot',
                              'createdAt', 'updatedAt'])
          && d.topicId is string && d.topicId.size() > 0
          && d.topicId.size() <= 128
          && d.resourceId is string && d.resourceId.size() > 0
          && d.resourceId.size() <= 128
          && d.subjectId is string && d.subjectId.size() <= 128
          && d.blockKey is string && d.blockKey.size() > 0
          && d.blockKey.size() <= 200
          && (d.colour == null
              || d.colour in ['yellow', 'green', 'blue', 'purple'])
          && d.text is string && d.text.size() <= 2000
          && d.snapshot is string && d.snapshot.size() <= 1000;
      }
      // Rules are not filters: a query must carry `userId == uid`.
      allow read, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.userId == request.auth.uid
        && noteShapeOk(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && resource.data.userId == request.auth.uid
        && noteShapeOk(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['colour', 'text', 'snapshot', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
    }

    // Bookmarks and the revision-card schedule, one document per student.
    // Always written with merge, and a merge is checked against the merged
    // document — so every field any writer uses must be named here, or
    // one feature's field would lock the other out.
    match /study/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys()
             .hasOnly(['userId', 'updatedAt', 'bookmarks', 'cards'])
        && request.resource.data.userId == uid
        && request.resource.data.updatedAt == request.time
        && (!('bookmarks' in request.resource.data)
            || (request.resource.data.bookmarks is map
                && request.resource.data.bookmarks.size() <= 500))
        && (!('cards' in request.resource.data)
            || (request.resource.data.cards is map
                && request.resource.data.cards.size() <= 5000));
    }

    // ── USERNAME REGISTRY (uniqueness enforcement) ───────────────
    // This collection *is* the uniqueness guarantee. A reservation can
    // only be created, never changed or released, so the first writer of
    // a key keeps it. `users/{uid}` will not accept a username unless a
    // reservation here already names that uid (see claimsOwnReservation).
    match /usernames/{normalised} {
      // Readable by any signed-in user, for the availability check.
      // Note this makes the username -> uid map enumerable; see the
      // privacy policy, which says usernames are public.
      allow read: if request.auth != null;

      allow create: if request.auth != null
        // Exactly these two fields, nothing smuggled alongside.
        && request.resource.data.keys().hasOnly(['uid', 'raw'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.raw is string
        // The document id must be the normalised form of the spelling
        // being claimed, so a user cannot park key X while displaying Y.
        && request.resource.data.raw.lower() == normalised
        && normalised.matches('^[a-z0-9_]{4,20}$');

      // Permanent: no renaming, no releasing, no reuse after deletion —
      // and none after a student moves to a new handle either, so a name
      // someone gave up cannot be taken to pass as them.
      allow update, delete: if false;
    }
  }
}
