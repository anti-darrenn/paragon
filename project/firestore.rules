rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /subjects/{id}  { allow read: if true; }
    match /units/{id}     { allow read: if request.auth != null; }
    match /topics/{id}    { allow read: if request.auth != null; }
    match /questions/{id} { allow read: if request.auth != null; }

    // ── USER DOCUMENTS ──────────────────────────────────────────
    // Owner-only, but no longer a blanket `write`: creation is limited to
    // an exact field set, and username/usernameKey can only be set by
    // claiming a matching reservation and are then immutable. Every other
    // field client code writes today (displayName, selectedSubjects,
    // profile) is allow-listed explicitly in `clientWritableFields` below;
    // anything not named there — including fields that don't exist yet,
    // like a future XP or topicStats — is server-only by construction.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow delete: if isOwner(uid);

      // Provisioning writes exactly these five fields — see
      // UserRepository.createUserIfNew. Restricted to that exact set
      // (not just "no username yet") so a client cannot `create` the
      // document directly with an extra field — e.g. a pre-set `level`
      // or `topicStats` — that then sits untouched forever, since
      // `onlyClientWritableFields` below only inspects what *changes* on
      // an update, never what already exists from creation.
      //
      // DEPRECATION SHIM (2026-09-20): `currentStreak`/`lastActiveDate`
      // are still named here although no client writes them any more.
      // Streaks were removed from the app, and `hasOnly` accepts a
      // subset, so naming them keeps a browser tab running the previous
      // build — which still sends all seven on sign-in — from being
      // denied its user document until it is refreshed. They are read by
      // nothing and pinned to nothing; a client that sends one stores a
      // field no code looks at. Delete both names once the old build is
      // no longer in anyone's cache.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
             'uid', 'email', 'displayName', 'isAnonymous', 'createdAt',
             'currentStreak', 'lastActiveDate'
           ])
        && request.resource.data.uid == uid
        // Forces the real serverTimestamp() sentinel rather than a
        // client-supplied value — the standard Firestore Rules idiom for
        // verifying serverTimestamp() was actually used.
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner(uid)
        && usernameWriteIsValid(uid)
        && onlyClientWritableFields();
    }

    // Allow-list, not a deny-list. Anything not named here cannot be
    // written from a client at all — including fields that do not exist
    // yet. When XP, levels and topicStats arrive they are therefore
    // server-only by default, and shipping a leaderboard does not depend
    // on somebody remembering to lock them first.
    function clientWritableFields() {
      return [
        'displayName', 'selectedSubjects', 'profile', 'updatedAt',
        'username', 'usernameKey',
        'email', 'isAnonymous',
        // See the DEPRECATION SHIM note on the create rule above. Kept so
        // an un-refreshed tab's final updateStreak() call is a harmless
        // no-op write rather than a permission error thrown at a student
        // mid-drill. Nothing reads these; remove with the create entry.
        'currentStreak', 'lastActiveDate'
      ];
    }

    function onlyClientWritableFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(clientWritableFields());
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Governs the username/usernameKey pair on an update. Three cases:
    //
    //   - the document already has a username -> it is immutable
    //   - the update does not mention one     -> nothing to check
    //   - the update claims one               -> it must match a
    //     reservation this user actually holds
    //
    // The last case is why usernames are lower-cased and nothing else:
    // rules can compute `.lower()` but cannot strip characters, so any
    // richer normalisation would be unverifiable here and uniqueness
    // would collapse back to a client-side promise.
    function usernameWriteIsValid(uid) {
      let after = request.resource.data;
      let hadUsername = 'username' in resource.data
        && resource.data.username is string
        && resource.data.username.size() > 0;

      return hadUsername
        ? (after.username == resource.data.username
            && after.usernameKey == resource.data.usernameKey)
        : (!('username' in after) && !('usernameKey' in after))
          || claimsOwnReservation(uid, after);
    }

    function claimsOwnReservation(uid, after) {
      return after.username is string
        && after.usernameKey is string
        && after.username.lower() == after.usernameKey
        && exists(/databases/$(database)/documents/usernames/$(after.usernameKey))
        && get(/databases/$(database)/documents/usernames/$(after.usernameKey)).data.uid == uid;
    }

    match /attempts/{id} {
      allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null
          && resource.data.userId == request.auth.uid;
      // Delete-own exists so account deletion can actually remove a
      // student's practice history. Still no update: an attempt is a
      // record of what happened and must not be edited after the fact.
      allow delete: if request.auth != null
          && resource.data.userId == request.auth.uid;
    }

    // ── PRACTICE PROGRESS (mastery rings) ────────────────────────
    // A private, display-only cache of per-topic counters, one document
    // per student, id'd by uid. It exists because counting `attempts` per
    // topic would need one aggregate query per topic — see
    // `progress_repository.dart` for the full reasoning.
    //
    // Deliberately NOT on `users/{uid}`: that document's allow-list keeps
    // stats fields server-only so a future leaderboard cannot be fed by
    // the client, and nothing here is allowed to undermine that. The
    // constraint that keeps the two compatible is a product rule, not a
    // rules-file one — nothing competitive may read this collection — so
    // it is written down in the repository and in CLAUDE.md. What the
    // rules can enforce, they do: owner-only in both directions, so these
    // numbers are never visible to another student, and a closed field
    // set, so this cannot become a dumping ground for whatever a client
    // feels like storing.
    match /progress/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['userId', 'updatedAt', 'topics'])
          && request.resource.data.userId == uid
          // Forces the real serverTimestamp() sentinel, the same way the
          // `users` create rule pins `createdAt`. Without it a client
          // could backdate its own cache, which matters the day anything
          // server-side starts reconciling this against `attempts`.
          && request.resource.data.updatedAt == request.time
          && request.resource.data.topics is map;
    }

    // ── QUESTION FLAGS (student-reported problems) ───────────────
    // The answer key is scraped from a third party with a measured error
    // rate, so students reporting a wrong answer is how we find the bad
    // ones. Write-only from the client: nothing reads these in the app,
    // they're queried with the Admin SDK, which bypasses rules.
    match /flags/{id} {
      allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid;
      // Read-own and delete-own, narrowly: a deleting user has to be able
      // to find and remove reports that carry their uid, and the client
      // cannot delete what it cannot query. Still no update, and still no
      // reading anyone else's — the admin path is unaffected.
      allow read, delete: if request.auth != null
          && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ── USERNAME REGISTRY (uniqueness enforcement) ───────────────
    // This collection *is* the uniqueness guarantee. A reservation can
    // only be created, never changed or released, so the first writer of
    // a key keeps it. `users/{uid}` will not accept a username unless a
    // reservation here already names that uid (see claimsOwnReservation).
    match /usernames/{normalised} {
      // Readable by any signed-in user, for the availability check.
      // Note this makes the username -> uid map enumerable; see the
      // privacy policy, which says usernames are public.
      allow read: if request.auth != null;

      allow create: if request.auth != null
        // Exactly these two fields, nothing smuggled alongside.
        && request.resource.data.keys().hasOnly(['uid', 'raw'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.raw is string
        // The document id must be the normalised form of the spelling
        // being claimed, so a user cannot park key X while displaying Y.
        && request.resource.data.raw.lower() == normalised
        && normalised.matches('^[a-z0-9_]{4,20}$');

      // Permanent: no renaming, no releasing, no reuse after deletion.
      allow update, delete: if false;
    }
  }
}
