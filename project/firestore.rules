rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /subjects/{id}  { allow read: if true; }
    match /units/{id}     { allow read: if request.auth != null; }
    match /topics/{id}    { allow read: if request.auth != null; }
    match /questions/{id} { allow read: if request.auth != null; }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /attempts/{id} {
      allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null
          && resource.data.userId == request.auth.uid;
    }

    // ── QUESTION FLAGS (student-reported problems) ───────────────
    // The answer key is scraped from a third party with a measured error
    // rate, so students reporting a wrong answer is how we find the bad
    // ones. Write-only from the client: nothing reads these in the app,
    // they're queried with the Admin SDK, which bypasses rules.
    match /flags/{id} {
      allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // ── USERNAME REGISTRY (uniqueness enforcement) ───────────────
    match /usernames/{normalised} {
      // Any authenticated user can read (for availability checks)
      allow read: if request.auth != null;
      // Only the owner can create their own username entry
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      // Usernames are permanent — no update or delete
      allow update, delete: if false;
    }
  }
}
